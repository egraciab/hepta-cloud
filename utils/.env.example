# ─── APP ───────────────────────────────────────────────
NODE_ENV=production
PORT=3100

# ─── DATABASE ──────────────────────────────────────────
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=heptacloud
DB_USER=heptacloud_user
DB_PASSWORD=CHANGE_ME

# ─── JWT ───────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ─── ODOO ──────────────────────────────────────────────
ODOO_URL=https://erp.hepta.com.py
ODOO_DB=hepta_prod
ODOO_USER=api@hepta.com.py
ODOO_PASSWORD=CHANGE_ME
ODOO_CACHE_TTL_INVOICES=900    # 15 min en segundos
ODOO_CACHE_TTL_TICKETS=300     # 5 min

# ─── MAIL (para notificaciones internas) ───────────────
SMTP_HOST=mail.hepta.com.py
SMTP_PORT=465
SMTP_USER=noreply@hepta.com.py
SMTP_PASS=CHANGE_ME
MAIL_FROM=Hepta Cloud <noreply@hepta.com.py>

# ─── MISC ──────────────────────────────────────────────
FRONTEND_PATH=/app/frontend
